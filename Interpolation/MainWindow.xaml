<Window x:Class="Interpolation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interpolation"
        mc:Ignorable="d"
        
        xmlns:MyControls="clr-namespace:Interpolation.MyControls"
        xmlns:sg="clr-namespace:Interpolation.MyControls.SelfGrowDataGrid"
        xmlns:conv="clr-namespace:Interpolation.Converters"
        xmlns:controls="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        
        FontFamily="Segoe UI"
        FontSize="12"
        Title="Интерполяция"
        Height="750"
        Width="565"
        ResizeMode="NoResize">
    
    <!--MenuBar-->
    <DockPanel>
        <Menu DockPanel.Dock="Top" Margin="4,0,0,0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" />
                <MenuItem Header="Сохранить" />
                <Separator />
                <MenuItem Header="Выход" />
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Показать формулу" />
                <MenuItem Header="Показать график" />
                <MenuItem Header="Панель ошибок" />
            </MenuItem>
            <MenuItem Header="Сравка">
                <MenuItem Header="О программе" />
            </MenuItem>
        </Menu>
    <!--MenuBar-->
        <Grid>
            <TabControl Margin="4">
                <!-- Первая вкладка -->
                <TabItem Header="Линейная">
                    <Grid x:Name="linearTabGrid"
                          ShowGridLines="True">
                        <!-- Грид 2строки. верх таблицы, низ графики -->
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid ShowGridLines="False"
                              Grid.Row="0">
                            <!-- Грид 2 столбца для групбоксов. слева исх. данные, справа результат -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"
                                                  MinWidth="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Исходные данные в левом столбце-->
                            <GroupBox x:Name="linearInputData"
                                      Header="Исходные данные"
                                      Grid.Column="0"
                                      Margin="4">
                                <sg:SelfGrowingDataGrid x:Name="linearInpDataGrid"
                                                        Margin="4">
                                    <sg:SelfGrowingDataGrid.Columns>
                                        <DataGridTextColumn Header="Аргумент"
                                                            Binding="{Binding Values[0].Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Значение"
                                                            Binding="{Binding Values[1].Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </sg:SelfGrowingDataGrid.Columns>
                                </sg:SelfGrowingDataGrid>
                            </GroupBox>
                            <!-- Результат -->
                            <GroupBox x:Name="linearResultData"
                                      Header="Результат"
                                      Grid.Column="1"
                                      Margin="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <sg:SelfGrowingDataGrid x:Name="linearResultDataGrid"
                                                            Margin="4"
                                                            Grid.Row="0"
                                                            AutoGenerateColumns="False">
                                        <sg:SelfGrowingDataGrid.Columns>
                                            <DataGridTextColumn Header="Аргумент"
                                                                Binding="{Binding Values[0].Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridTextColumn Header="Результат"
                                                                IsReadOnly="True"
                                                                Binding="{Binding Values[1].Value, UpdateSourceTrigger=PropertyChanged}"
                                                                sg:GridColumnExtensions.IsFillingRequired="False" />
                                            <DataGridTemplateColumn IsReadOnly="True"
                                                                    sg:GridColumnExtensions.IsFillingRequired="False">
                                                <!-- Шапка столбца — общая кнопка "Скопировать всё" -->
                                                <DataGridTemplateColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Button x:Name="CopyAllButton"
                                                                Content="Скопировать всё"
                                                                Padding="4"
                                                                Click="CopyAllButton_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.HeaderTemplate>

                                                <!-- Ячейка столбца — своя кнопка на каждую строку -->
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Скопировать"
                                                                Padding="2"
                                                                IsEnabled="{Binding Values[1].Value, Converter={StaticResource NullToBoolConverter}}"
                                                                Tag="{Binding}"
                                                                Click="CopyRowButton_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header=""
                                                                IsReadOnly="True"
                                                                Width="85"
                                                                Binding="{Binding Values[3].Value, UpdateSourceTrigger=PropertyChanged}"
                                                                sg:GridColumnExtensions.IsFillingRequired="False" />

                                        </sg:SelfGrowingDataGrid.Columns>
                                    </sg:SelfGrowingDataGrid>

                                    <MyControls:SliderWithTextBlocks Grid.Row="1"
                                                                     LeftText="Точность:"
                                                                     Minimum="0"
                                                                     Maximum="5"
                                                                     Step="1"
                                                                     Value="{Binding Precision, Mode=TwoWay}">
                                    </MyControls:SliderWithTextBlocks>
                                </Grid>
                            </GroupBox>
                        </Grid>
                        <Grid ShowGridLines="False"
                              Grid.Row="1"
                              Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <GroupBox Header="Формула"
                                      Grid.Row="0">
                                <controls:FormulaControl Formula="{Binding FormulaLatex}"
                                                         
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Scale="20"
                                                         Padding="10" />
                            </GroupBox>
                            <GroupBox Header="График"
                                      Grid.Row="1">
                                
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- Вторая вкладка -->
                <TabItem Header="Квадратная">
                    <Grid x:Name="squareTabGrid"
                          Margin="4"
                          ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- Исходные данные -->
                        <GroupBox x:Name="squareInputData"
                                  Margin="4"
                                  Header="Исходные данные">

                        </GroupBox>
                        <!-- Результат -->
                        <GroupBox x:Name="squareResultData"
                                  Margin="4"
                                  Header="Результат"
                                  Grid.Column="1">
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

    
</Window>
