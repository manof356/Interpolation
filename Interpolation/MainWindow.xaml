<Window x:Class="Interpolation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interpolation"
        mc:Ignorable="d"
        
        xmlns:MyControls="clr-namespace:Interpolation.MyControls"
        xmlns:sg="clr-namespace:Interpolation.MyControls.SelfGrowDataGrid"
        
        FontFamily="Segoe UI"
        FontSize="12"
        Title="Интерполяция"
        Height="500"
        Width="500"
        ResizeMode="NoResize">
    
    <!--MenuBar-->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" />
                <MenuItem Header="Сохранить" />
                <Separator />
                <MenuItem Header="Выход" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Копировать" />
                <MenuItem Header="Вставить" />
            </MenuItem>
        </Menu>
    <!--MenuBar-->
        <Grid>
            <TabControl Margin="4">
                <!-- Первая вкладка -->
                <TabItem Header="Линейная">
                    <Grid x:Name="linearTabGrid"
                          Margin="4"
                          ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Исходные данные -->
                        <GroupBox x:Name="linearInputData"
                                  Margin="4"
                                  Header="Исходные данные">
                            <sg:SelfGrowingDataGrid x:Name="linearInpDataGrid"
                                                            Margin="4"
                                                            Grid.Row="0">
                                <sg:SelfGrowingDataGrid.Columns>
                                    <DataGridTextColumn Header="Аргумент"
                                                        Binding="{Binding Values[0].Value, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Значение"
                                                        Binding="{Binding Values[1].Value, UpdateSourceTrigger=PropertyChanged}" />
                                </sg:SelfGrowingDataGrid.Columns>
                            </sg:SelfGrowingDataGrid>

                        </GroupBox>
                        <!-- Результат -->
                        <GroupBox x:Name="linearResultData"
                                  Margin="4"
                                  Header="Результат"
                                  Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition  />
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <sg:SelfGrowingDataGrid x:Name="linearResultDataGrid"
                                                           Margin="4"
                                                           Grid.Row="0"
                                                           AutoGenerateColumns="False">
                                    <sg:SelfGrowingDataGrid.Columns>
                                        <DataGridTextColumn Header="Аргумент"
                                                            Binding="{Binding Values[0].Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Результат"
                                                            IsReadOnly="True"
                                                            Binding="{Binding Values[1].Value, UpdateSourceTrigger=PropertyChanged}"
                                                            sg:GridColumnExtensions.IsFillingRequired="False" />
                                        <DataGridTextColumn Header=""
                                                            IsReadOnly="True"
                                                            Binding="{Binding Values[2].Value, UpdateSourceTrigger=PropertyChanged}"
                                                            sg:GridColumnExtensions.IsFillingRequired="False" />
                                    </sg:SelfGrowingDataGrid.Columns>
                                </sg:SelfGrowingDataGrid>
                                
                                <MyControls:SliderWithTextBlocks Grid.Row="1"
                                                                 LeftText="Точность:"
                                                                 Minimum="0"
                                                                 Maximum="5"
                                                                 Step="1"
                                                                 Value="{Binding Precision, Mode=TwoWay}">

                                </MyControls:SliderWithTextBlocks>
                                
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- Вторая вкладка -->
                <TabItem Header="Квадратная">
                    <Grid x:Name="squareTabGrid"
                          Margin="4"
                          ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- Исходные данные -->
                        <GroupBox x:Name="squareInputData"
                                  Margin="4"
                                  Header="Исходные данные">

                        </GroupBox>
                        <!-- Результат -->
                        <GroupBox x:Name="squareResultData"
                                  Margin="4"
                                  Header="Результат"
                                  Grid.Column="1">
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

    
</Window>
