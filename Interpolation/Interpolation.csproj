<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Source\Linterp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Source\SPDV_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Source\Linterp.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
	<Compile Update="MainWindow.Formula.cs">
		<DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
	<Compile Update="MainWindow.Plot.cs">
		<DependentUpon>MainWindow.xaml</DependentUpon>
	</Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Source\SPDV_logo.png" />
  </ItemGroup>

</Project>
